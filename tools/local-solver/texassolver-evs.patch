+json PCfrSolver::dumpEvs() {
+    vector<vector<PrivateCards>> player_privates(this->player_number);
+    player_privates[0] = pcm.getPreflopCards(0);
+    player_privates[1] = pcm.getPreflopCards(1);
+    BestResponse br = BestResponse(player_privates,this->player_number,this->pcm,this->rrm,this->deck,this->debug,this->color_iso_offset,this->split_round,this->num_threads);
+    vector<vector<float>> reach_probs(this->player_number);
+    for(int p = 0;p < this->player_number;p ++){
+        reach_probs[p] = vector<float>(player_privates[p].size());
+        for(int i = 0;i < player_privates[p].size();i ++) reach_probs[p][i] = player_privates[p][i].weight;
+    }
+    json out;
+    for(int p = 0;p < this->player_number;p ++){
+        vector<float> evs = br.handEvs(this->tree->getRoot(), p, reach_probs, this->initial_board_long);
+        json one;
+        for(int i = 0;i < player_privates[p].size();i ++) if(evs[i] > -1e29f) one[player_privates[p][i].toString()] = evs[i];
+        out[std::to_string(p)] = one;
+    }
+    return out;
+}
+
+void PCfrSolver::fillActionEvs() {
+    this->action_evs.clear();
+    const char* kind = getenv("TEXASSOLVER_ACTION_EVS");
+    if(kind != nullptr && string(kind) == "off") return;
+    this->action_evs_best = kind != nullptr && string(kind) == "best";
+    vector<vector<PrivateCards>> player_privates(this->player_number);
+    player_privates[0] = pcm.getPreflopCards(0);
+    player_privates[1] = pcm.getPreflopCards(1);
+    BestResponse br = BestResponse(player_privates,this->player_number,this->pcm,this->rrm,this->deck,this->debug,this->color_iso_offset,this->split_round,this->num_threads);
+    vector<vector<float>> reach_probs(this->player_number);
+    for(int p = 0;p < this->player_number;p ++){
+        reach_probs[p] = vector<float>(player_privates[p].size());
+        for(int i = 0;i < player_privates[p].size();i ++) reach_probs[p][i] = player_privates[p][i].weight;
+    }
+    for(int p = 0;p < this->player_number;p ++) br.actionEvs(this->tree->getRoot(), p, reach_probs, this->initial_board_long, this->action_evs, this->action_evs_best);
+}
